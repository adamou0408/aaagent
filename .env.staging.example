# Staging Environment
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Database
DB_HOST=db
DB_PORT=5432
DB_USERNAME=aaagent
DB_PASSWORD=CHANGE_ME_staging_password
DB_DATABASE=aaagent_staging
DB_POOL_SIZE=5

# Auth
JWT_SECRET=CHANGE_ME_staging_jwt_secret
JWT_EXPIRATION=24h

# CORS
CORS_ORIGIN=https://staging.example.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
